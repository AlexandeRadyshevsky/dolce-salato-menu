# --- сервер ---
PORT=3001
HOST=127.0.0.1
DB_PATH=data/dolcesalato.db
# если фронт и API на одном домене (nginx проксирует /api) — CORS не нужен
CORS_ORIGIN=
# админка https://dolcesalato.ru/admin — пароль для входа заказчика
ADMIN_PASSWORD=
# секрет подписи сессий (любая длинная случайная строка: openssl rand -hex 32)
SESSION_SECRET=
# 0 — только для локальной разработки без https
COOKIE_SECURE=1
# токен для скриптов/интеграций: Authorization: Bearer <ADMIN_TOKEN> на /api/admin/*
ADMIN_TOKEN=

# --- письмо менеджеру о новой заявке ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@dolcesalato.ru
SMTP_PASS=
MAIL_FROM="Dolce&Salato <noreply@dolcesalato.ru>"
MAIL_TO=ds.zakaz@gmail.com

# --- Unisender (рассылки) ---
# ключ: Unisender → Настройки → Интеграция и API
UNISENDER_API_KEY=
# заполните, запустив: npm run unisender:setup
UNISENDER_MAIN_LIST_ID=
UNISENDER_SEGMENT_LISTS='{}'
# 3 — согласие получено формой на сайте, контакт сразу активен
UNISENDER_DOUBLE_OPTIN=3
